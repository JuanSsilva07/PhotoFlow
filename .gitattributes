# Auto-detect text files and normalize line endings
* text=auto

# Kotlin and XML source files — always LF
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.apk binary
*.jks binary
*.keystore binary
*.so binary
*.aar binary

